# Local AI (free) — install Ollama from https://ollama.com/download, then:
#   ollama pull llama3.2:3b
# Without Ollama running, the newsroom falls back to a template writer.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# GNews API Key (optional, free: 100 req/day) — https://gnews.io/register
# Without it, headlines come from the free Google News RSS feed (no images).
GNEWS_API_KEY=your-gnews-key-here

# YouTube Data API v3 (free: 10,000 units/day) — https://console.cloud.google.com/apis
YOUTUBE_API_KEY=your-youtube-key-here

# Frontend URL for CORS in production (optional)
# FRONTEND_URL=https://your-domain.com

# Server port for production (optional, defaults to 3001)
# PORT=3001
